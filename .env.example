# Copy to .env and fill what you have. Missing keys only disable that source.

# DeepSeek (keyword labels, topics, research wording)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# Apple Ads (weekly search popularity; free)
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=
APPLE_ADS_PRIVATE_KEY_PATH=
APPLE_ADS_AD_ACCOUNT_ID=

# App Store Connect (your own apps' sales; free)
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_PRIVATE_KEY_PATH=
ASC_VENDOR_NUMBER=

# DataForSEO (Google volume, CPC, Trends, Play; pay per task)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Verified revenue anchors (free)
TRUSTMRR_API_KEY=

# ScrapeCreators (Reddit, TikTok, YouTube, Meta Ad Library; 1 credit per request)
SCRAPECREATORS_API_KEY=

# Local
# ASTRO_MCP_URL=http://127.0.0.1:8089/mcp
