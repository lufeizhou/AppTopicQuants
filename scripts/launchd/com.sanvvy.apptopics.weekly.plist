<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.sanvvy.apptopics.weekly</string>
  <key>ProgramArguments</key><array>
    <string>/Users/lufei/Documents/AppTopicsQuants/.venv/bin/apptopics</string><string>collect</string><string>all</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/lufei/Documents/AppTopicsQuants</string>
  <!-- Wednesday 04:00 local: Apple's weekly popularity (Sun-Sat, ~1 week lag) has had 3 days to publish; Trends weekly points are complete. -->
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/lufei/Documents/AppTopicsQuants/logs/weekly.log</string>
  <key>StandardErrorPath</key><string>/Users/lufei/Documents/AppTopicsQuants/logs/weekly.err</string>
  <key>RunAtLoad</key><false/>
</dict></plist>
